# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── MySQL (local development) ─────────────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=railway

# ── Railway deployment ────────────────────────────────────────────────────────
# When deploying on Railway, these are injected automatically via service
# variable references in the Railway dashboard. You do not need to set them
# manually — add the following to your app service Variables (Raw Editor):
#
#   MYSQL_HOST=${{MySQL.MYSQLHOST}}
#   MYSQL_PORT=${{MySQL.MYSQLPORT}}
#   MYSQL_USER=${{MySQL.MYSQLUSER}}
#   MYSQL_PASSWORD=${{MySQL.MYSQLPASSWORD}}
#   MYSQL_DATABASE=${{MySQL.MYSQLDATABASE}}
